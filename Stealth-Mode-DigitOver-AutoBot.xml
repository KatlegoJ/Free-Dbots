<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <!-- Original Variables -->
    <variable type="" id="NF4F:F)/OD%/WGw?#p21">LAST DIGIT</variable>
    <variable type="" id="hI@Y}s|lTxY^B?|ePQo3">MAXIMUM LOSS</variable>
    <variable type="" id="B1QULQFHhsY:UDFFic@Y">TARGET</variable>
    <variable type="" id="GYiy?v@WnvT%BAgL0J7S">STAKE</variable>
    <variable type="" id="F4wur(a=}{e-X~0WBkHA">WIN STAKE</variable>
    
    <!-- New Strategic Variables -->
    <variable type="" id="rsi_level">RSI_LEVEL</variable>
    <variable type="" id="atr_value">ATR_VALUE</variable>
    <variable type="" id="risk_percent">RISK_PERCENT</variable>
    <variable type="" id="session_active">SESSION_ACTIVE</variable>
  </variables>

  <!-- ================= STRATEGIC ENHANCEMENTS ================= -->
  <block type="market_condition" id="london_session" x="50" y="100">
    <field name="CONDITION">TIME BETWEEN 07:00-16:00 GMT</field>
    <field name="VOLATILITY">ABOVE 0.8%</field>
    <next>
      <block type="technical_strategy" id="trend_filter">
        <field name="INDICATOR_1">RSI(14)</field>
        <field name="CONDITION">BELOW 30</field>
        <field name="INDICATOR_2">MACD(12,26,9)</field>
        <field name="LOGIC">CROSS ABOVE SIGNAL</field>
        <next>
          <!-- Dynamic Position Sizing -->
          <block type="variables_set" id="safe_stake">
            <field name="VAR" id="GYiy?v@WnvT%BAgL0J7S">STAKE</field>
            <value name="VALUE">
              <block type="math_round">
                <field name="OP">MAX</field>
                <value name="NUM">
                  <block type="math_arithmetic">
                    <field name="OP">DIVIDE</field>
                    <value name="A">
                      <block type="math_multiple">
                        <block type="account_balance"/>
                        <block type="variables_get">
                          <field name="VAR" id="risk_percent">RISK_PERCENT</field>
                        </block>
                      </block>
                    </value>
                    <value name="B">100</value>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </next>
      </block>
    </next>
  </block>

  <!-- ================= SMART TRADE EXECUTION ================= -->
  <block type="trade" id="enhanced_trade" x="300" y="150">
    <field name="MARKET_LIST">synthetic_index</field>
    <field name="TRADETYPECAT_LIST">volatility</field>
    <statement name="SUBMARKET">
      <block type="tradeOptions" id="smart_exits">
        <field name="TAKE_PROFIT">ATR(14)*1.5</field>
        <field name="STOP_LOSS">ATR(14)*0.75</field>
        <value name="AMOUNT">
          <block type="variables_get" id="dynamic_stake">
            <field name="VAR" id="GYiy?v@WnvT%BAgL0J7S">STAKE</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <!-- ================= RISK CONTROL SYSTEMS ================= -->
  <block type="emergency_stop" id="drawdown_protection" x="550" y="200">
    <field name="CONDITION">DAILY_LOSS > 5%</field>
    <field name="ACTION">HALT 24H</field>
    <next>
      <block type="circuit_breaker" id="volatility_adjust">
        <field name="MEASURE">ATR(14)</field>
        <field name="MAX_THRESHOLD">2.5%</field>
        <field name="RESPONSE">REDUCE_POSITION 50%</field>
      </block>
    </next>
  </block>

  <!-- ================= PROFIT RECYCLING SYSTEM ================= -->
  <block type="variables_set" id="profit_boost" x="800" y="250">
    <field name="VAR" id="GYiy?v@WnvT%BAgL0J7S">STAKE</field>
    <value name="VALUE">
      <block type="math_arithmetic">
        <field name="OP">ADD</field>
        <value name="A">
          <block type="variables_get">
            <field name="VAR" id="GYiy?v@WnvT%BAgL0J7S">STAKE</field>
          </block>
        </value>
        <value name="B">
          <block type="math_arithmetic">
            <field name="OP">MULTIPLY</field>
            <value name="A">
              <block type="total_profit"/>
            </value>
            <value name="B">0.25</value>
          </block>
        </value>
      </block>
    </value>
  </block>

  <!-- ================= ORIGINAL LOGIC (MODIFIED FOR SAFETY) ================= -->
  <!-- Kept your original structure but added risk filters -->
  <block type="during_purchase" id="safe_purchase" x="200" y="400">
    <statement name="DURING_PURCHASE_STACK">
      <block type="controls_if" id="enhanced_decision">
        <mutation elseif="2"></mutation>
        <value name="IF0">
          <block type="logic_and">
            <value name="A">
              <!-- Original digit condition -->
              <block type="logic_compare" id="safe_condition">
                <field name="OP">EQ</field>
                <value name="A">
                  <block type="last_digit"/>
                </value>
                <value name="B">
                  <block type="math_number">
                    <field name="NUM">5</field>
                  </block>
                </value>
              </block>
            </value>
            <value name="B">
              <!-- New volatility filter -->
              <block type="market_condition">
                <field name="VOLATILITY">BETWEEN 0.5-2%</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <!-- Your original purchase logic -->
          <block type="purchase" id="controlled_buy">
            <field name="PURCHASE_LIST">DIGITOVER</field>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <!-- ================= PERFORMANCE ANALYTICS ================= -->
  <block type="analytics" id="real_time_stats" x="700" y="500">
    <field name="METRICS">WIN_RATE,PROFIT_FACTOR,SHARPE_RATIO</field>
    <field name="REFRESH">60</field>
  </block>
</xml>
